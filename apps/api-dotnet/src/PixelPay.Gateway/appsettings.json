{
  "ReverseProxy": {
    "Routes": {
      "dotnet-auth": {
        "ClusterId": "dotnet",
        "Match": { "Path": "/api/v1/auth/{**rest}" }
      },
      "dotnet-users": {
        "ClusterId": "dotnet",
        "Match": { "Path": "/api/v1/users/{**rest}" }
      },
      "dotnet-wallet": {
        "ClusterId": "dotnet",
        "Match": { "Path": "/api/v1/wallet" }
      },
      "dotnet-wallet-rest": {
        "ClusterId": "dotnet",
        "Match": { "Path": "/api/v1/wallet/{**rest}" }
      },
      "dotnet-orders-list": {
        "ClusterId": "dotnet",
        "Match": { "Path": "/api/v1/orders", "Methods": [ "GET", "HEAD" ] }
      },
      "dotnet-orders-get": {
        "ClusterId": "dotnet",
        "Match": { "Path": "/api/v1/orders/{id}", "Methods": [ "GET", "HEAD" ] }
      },
      "node": {
        "ClusterId": "node",
        "Order": 1000,
        "Match": { "Path": "/{**rest}" }
      }
    },
    "Clusters": {
      "dotnet": {
        "HttpRequest": { "ActivityTimeout": "00:01:40" }
      },
      "node": {
        "HttpRequest": { "ActivityTimeout": "00:01:40" }
      }
    }
  }
}
