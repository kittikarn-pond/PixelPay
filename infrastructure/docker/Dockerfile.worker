# Stage 1: Build
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS builder
WORKDIR /src
COPY apps/api-dotnet/global.json apps/api-dotnet/Directory.Build.props apps/api-dotnet/Directory.Packages.props ./
COPY apps/api-dotnet/src/PixelPay.Domain/PixelPay.Domain.csproj src/PixelPay.Domain/
COPY apps/api-dotnet/src/PixelPay.Application/PixelPay.Application.csproj src/PixelPay.Application/
COPY apps/api-dotnet/src/PixelPay.Infrastructure/PixelPay.Infrastructure.csproj src/PixelPay.Infrastructure/
COPY apps/api-dotnet/src/PixelPay.Worker/PixelPay.Worker.csproj src/PixelPay.Worker/
RUN dotnet restore src/PixelPay.Worker/PixelPay.Worker.csproj
COPY apps/api-dotnet/src ./src
RUN dotnet publish src/PixelPay.Worker/PixelPay.Worker.csproj -c Release -o /out --no-restore

# Stage 2: Run
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runner
RUN apt-get update && apt-get install -y --no-install-recommends wget && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder --chown=app:app /out ./
USER app
# WORKER_QUEUES selects the Hangfire queues (topup, payments, notifications; default all).
ENV WORKER_PORT=3100
EXPOSE 3100
HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
  CMD wget -q -O /dev/null http://localhost:3100/healthz || exit 1
ENTRYPOINT ["dotnet", "PixelPay.Worker.dll"]
